<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>My Day</string>
	<key>NSCameraUsageDescription</key>
	<string>日々の短い動画を素早く撮影するため、カメラを使用します。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>動画に周囲の音声も記録するため、マイクを使用します。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>撮影した動画を写真ライブラリへ保存するために使用します。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>日別ライブラリで過去の動画を表示するために使用します。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>設定で位置情報の記録をオンにした場合、撮影した動画に現在地と地名を記録するために使用します。</string>
</dict>
</plist>
